[
  {
    "origin": ["*"],
    "method": ["GET", "PUT", "POST", "DELETE"],
    "maxAgeSeconds": 3600,
    "responseHeader": [
      "Content-Type",
      "Authorization",
      "Content-Length",
      "Content-Range",
      "Accept-Ranges",
      "User-Agent",
      "Cache-Control",
      "ETag"
    ]
  }
]
