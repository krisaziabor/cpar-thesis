# ─── Kanon — environment variables ──────────────────────────────────────────
# Copy to `.env.local` and fill in. Anything prefixed `NEXT_PUBLIC_` is exposed
# to the browser; everything else is server-only.

# ─── Firebase (client SDK) ──────────────────────────────────────────────────
# From Firebase Console → Project settings → General → Your apps → Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin (server SDK) ────────────────────────────────────────────
# Required for /api/auth/send-magic-link and any server-side Firestore work.
# Generate at Firebase Console → Project settings → Service accounts → Generate
# new private key. Paste the entire JSON as a single-line string (escape quotes).
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── Magic-link email (Resend) ──────────────────────────────────────────────
# Required to send sign-in emails. Get a key at https://resend.com/api-keys.
# RESEND_FROM must be a verified sender on a domain you own.
RESEND_API_KEY=
RESEND_FROM="Kanon <noreply@yourdomain.com>"

# Optional: public HTTPS origin used for images/fonts in outbound email.
# Email inboxes cannot load http://localhost — set this to a deployed origin
# (e.g. https://kanon.yourdomain.com) when testing magic links from local dev.
EMAIL_ASSET_ORIGIN=

# ─── App origin ─────────────────────────────────────────────────────────────
# Production URL of the app. Used as a fallback for the magic-link continueUrl
# when the request origin isn't recognized. On Vercel, VERCEL_URL is auto-set.
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ─── Registration gate ──────────────────────────────────────────────────────
# Set to "false" to block sign-ups from emails not already in the whitelist.
NEXT_PUBLIC_REGISTRATION_OPEN=true

# ─── AI / metadata ──────────────────────────────────────────────────────────
# Anthropic Claude — used by /api/metadata (PDF author detection) and
# /api/transcribe (audio transcription).
ANTHROPIC_API_KEY=

# Optional: confidence threshold (0–1) for accepting Haiku's metadata guess.
METADATA_AI_THRESHOLD=

# Optional: ElevenLabs (alternate transcription / voice synthesis backend).
ELEVENLABS_API_KEY=

# ─── External media APIs (optional) ─────────────────────────────────────────
# Add only the ones you need; missing keys disable that source quietly.
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# ─── yt-dlp (optional, for YouTube audio mirroring) ─────────────────────────
# Pick ONE strategy:
#   1. YT_DLP_COOKIES_FILE — absolute path to a cookies.txt file on disk.
#   2. YT_DLP_COOKIES_CONTENT — raw cookies.txt contents inline (for serverless).
#   3. YT_DLP_COOKIES_FROM_BROWSER — e.g. "chrome", "firefox" (local dev only).
YT_DLP_COOKIES_FILE=
YT_DLP_COOKIES_CONTENT=
YT_DLP_COOKIES_FROM_BROWSER=

# Optional: external yt-dlp microservice (offloads downloads from Vercel).
YOUTUBE_DL_HOST=
YOUTUBE_DL_PATH=

# ─── Feature flags ──────────────────────────────────────────────────────────
# Set to "true" to disable the YouTube → Haiku music-metadata fallback.
DISABLE_MUSIC_YOUTUBE_HAIKU_FALLBACK=
