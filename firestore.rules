rules_version = '2';

// Kanon Firestore security rules.
// Deploy with: firebase deploy --only firestore:rules
// See README for Firebase CLI setup.

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the authenticated user is an admin.
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/whitelist/$(request.auth.token.email)).data.role == 'admin';
    }

    // Whitelist: anyone may look up a specific document by ID (needed for the
    // pre-login email check), but listing the collection is blocked.
    // Authenticated users may create their own entry (self-registration).
    // Only admins (or Firebase Console) can update/delete entries.
    match /whitelist/{email} {
      allow get: if true;
      allow list: if request.auth != null && isAdmin();
      allow create: if request.auth != null
        && request.auth.token.email == email;
      allow update, delete: if false;
    }

    // Placeholder: allow read/write for authenticated users only.
    // Tighten for production: restrict by community whitelist, validate fields, etc.
    match /communities/{communityId} {
      allow read, write: if request.auth != null;
    }
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Shared item type vocabulary for the Add form combobox.
    match /item_types/{typeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.created_by == request.auth.token.email;
      allow update: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      allow delete: if false;
    }

    match /items/{itemId} {
      // Published items are readable by any authenticated user.
      // Draft items are readable only by their author (added_by == email).
      allow read: if request.auth != null
        && (!resource.data.is_draft
            || resource.data.added_by == request.auth.token.email);
      // Anyone authenticated may create an item (they become the author).
      allow create: if request.auth != null;
      // Author may update their own items; admins and authors may delete.
      allow update: if request.auth != null
        && resource.data.added_by == request.auth.token.email;
      allow delete: if request.auth != null
        && (resource.data.added_by == request.auth.token.email || isAdmin());

      // Audio versions subcollection
      match /audio_versions/{versionId} {
        // Any authenticated user can read version history.
        allow read: if request.auth != null;
        // Only the item's author may add a new version.
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/items/$(itemId)).data.added_by
             == request.auth.token.email;
        // Admins may delete versions; no one else may update or delete.
        allow delete: if isAdmin();
        allow update: if false;
      }

      // Item responses (voice replies to an item)
      match /responses/{responseId} {
        allow read, write: if request.auth != null;
      }
    }
    match /connections/{connectionId} {
      allow read, write: if request.auth != null;
      match /items/{connectionItemId} {
        allow read, write: if request.auth != null;
      }
      match /responses/{responseId} {
        allow read, write: if request.auth != null;
      }
    }

    // connection_items: junction table used for connection checks.
    match /connection_items/{docId} {
      allow read, write: if request.auth != null;
    }

    // Personal Kanon saves
    match /kanon_saves/{saveId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.user_email == request.auth.token.email;
      allow delete: if request.auth != null
        && resource.data.user_email == request.auth.token.email;
      allow update: if false;
    }

    // Per-user onboarding checklist progress
    match /user_checklist_progress/{docId} {
      // Allow authenticated reads so first-time users can initialize/subscribe
      // before their progress document exists.
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.user_email == request.auth.token.email;
      allow update: if request.auth != null
        && resource.data.user_email == request.auth.token.email
        && request.resource.data.user_email == request.auth.token.email;
      allow delete: if false;
    }

    // Metadata cache — written by server-side API routes (no user auth context).
    // Contains only public URL metadata; no user PII.
    match /metadataCache/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Enrichment logs — written by server-side API routes (no user auth context).
    // Internal monitoring data only; no user PII.
    match /metadataEnrichmentLogs/{docId} {
      allow read: if request.auth != null && isAdmin();
      allow write: if true;
    }

    // Deletion requests
    match /deletion_requests/{requestId} {
      // Any authenticated user may submit a deletion request.
      allow create: if request.auth != null;
      // Requester or admin may read their own request; admin sees all.
      allow read: if request.auth != null
        && (resource.data.requested_by == request.auth.token.email || isAdmin());
      // Only admins may resolve (update) requests.
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Installation onboarding — pre-launch opt-in flow.
    // Doc ID is the user's email. Users can only read/write their own document.
    // Admins can read all documents (to review opt-ins and book submissions).
    match /installation_onboarding/{email} {
      allow read: if request.auth != null
        && (request.auth.token.email == email || isAdmin());
      allow create: if request.auth != null
        && request.auth.token.email == email
        && request.resource.data.user_email == email;
      allow update: if request.auth != null
        && request.auth.token.email == email
        && resource.data.user_email == email;
      allow delete: if false;
    }

    // Product feedback submissions
    match /feedback/{feedbackId} {
      // Authenticated users can create feedback tied to their own identity.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
             'user_id',
             'user_email',
             'user_name',
             'text',
             'created_at',
           ])
        && request.resource.data.keys().hasAll([
             'user_id',
             'user_email',
             'user_name',
             'text',
             'created_at',
           ])
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.user_email == request.auth.token.email
        && request.resource.data.user_name is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1200
        && request.resource.data.created_at == request.time;

      // Feedback is internal; admin-only reads.
      allow read: if request.auth != null && isAdmin();
      allow update, delete: if false;
    }
  }
}
