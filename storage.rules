rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // User testimony audio recordings, max 50 MB.
    match /audio/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    // User-uploaded file attachments (images / PDFs), max 100 MB.
    match /files/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 100 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null;
    }

    // Auto-mirrored thumbnails (OG images, YouTube/music album art, etc.), max 10 MB.
    match /thumbnails/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Mirrored short audio previews (Spotify 30s previews, etc.), max 10 MB.
    match /previews/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null;
    }

    // Downloaded video files (Instagram Reels, TikTok, YouTube, Twitter), max 500 MB.
    match /media/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null;
    }
  }
}
