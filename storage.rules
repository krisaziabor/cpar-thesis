rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // All audio is readable by any authenticated user.
    // Writes are limited to authenticated users, max 50 MB, audio MIME type only.
    // Delete is allowed so users can re-record or items can be removed.
    match /audio/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024;
      allow delete: if request.auth != null;
    }
    // Images and PDFs attached to items, max 20 MB.
    match /files/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 100 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null;
    }
  }
}
